[Unit]
Description=FreshTradeLeads production sales website
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/freshtradeleads
EnvironmentFile=/etc/freshtradeleads-web.env
EnvironmentFile=/etc/freshtradeleads-public-sandbox.env
EnvironmentFile=/etc/freshtradeleads-live.env
ExecStart=/opt/freshtradeleads/.venv/bin/uvicorn --factory freshtradeleads.web:create_app --host 127.0.0.1 --port 8080 --workers 2 --no-proxy-headers --no-access-log --limit-concurrency 100 --timeout-keep-alive 10
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/deploy/.config/stripe
ReadWritePaths=/opt/freshtradeleads/data/web
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
