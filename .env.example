# Local PostgreSQL over the Unix socket; production value lives outside Git.
FRESHTRADELEADS_DATABASE_URL=postgresql+psycopg:///freshtradeleads
FRESHTRADELEADS_DATA_DIR=./data
# Web/Stripe values belong in an untracked environment file, never Git.
FRESHTRADELEADS_BASE_URL=https://leads.example.com
FRESHTRADELEADS_SESSION_SECRET=replace-with-random-secret
FRESHTRADELEADS_SECURE_COOKIES=true
FRESHTRADELEADS_ALLOWED_HOSTS=leads.example.com,localhost,127.0.0.1
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_STARTER=price_replace_me
STRIPE_PRICE_FRESH_PACK=price_replace_me
STRIPE_PRICE_EXPANDED=price_replace_me
FRESHTRADELEADS_PROMOTION_CODE=EXAMPLE20
FRESHTRADELEADS_PROMOTION_PERCENT=20
STRIPE_PROMOTION_CODE_ID=promo_replace_me
# Private sandbox only. Production uses STRIPE_SECRET_KEY instead.
STRIPE_USE_CLI=false
# Browser-side Meta Pixel identifier only; this is not an API access token.
META_PIXEL_ID=replace-with-numeric-dataset-id
